# USCIS Form Processor — environment variables
# Copy to .env and fill in real values before running.
#
#   cp .env.example .env
#
# For local dev with run.sh, export these in your shell:
#   export ANTHROPIC_API_KEY=sk-ant-...
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export DATABASE_URL=postgresql://uscis:password@localhost:5432/legal_processing

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key — used by the LLM fallback stage (claude-sonnet-4-*)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini API key — enables Gemini 2.0 Flash for extraction (optional)
# If not set, falls back to NuExtract
# Get at https://ai.google.dev/
GOOGLE_API_KEY=

# JWT signing secret — use a random 32+ byte hex string in production
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL connection string
# Docker Compose: set POSTGRES_PASSWORD below; DATABASE_URL is built automatically
# Direct: replace host/user/password/dbname as needed
DATABASE_URL=postgresql://uscis:password@localhost:5432/legal_processing

# ---------------------------------------------------------------------------
# Optional (have defaults)
# ---------------------------------------------------------------------------

# Uvicorn port (default: 8001)
PORT=8001

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------

# PostgreSQL superuser password used by the postgres service.
# DATABASE_URL in docker-compose.yml is built from this automatically.
POSTGRES_PASSWORD=change-me-in-production
