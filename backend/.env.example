# Core
PORT=3001
NODE_ENV=development

# Auth
# AUTH_MODE=local  → validates own JWT (default, standalone)
# AUTH_MODE=mosaic → validates token by calling MOSAIC_API_URL (for Altascio Mosaic integration)
AUTH_MODE=local
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Mosaic integration (only used when AUTH_MODE=mosaic)
MOSAIC_API_URL=https://api.altascio.com

# AI
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Instagram OAuth (leave blank to disable; routes return 503 when not configured)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/v1/social/instagram/callback

# LinkedIn OAuth (leave blank to disable)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/social/linkedin/callback

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL — used for OAuth callback redirects
FRONTEND_URL=http://localhost:5173
